{
  "name": "deburst-func",
  "version": "1.0.0",
  "description": "Trailing-edge debounce with a hard time ceiling: collapses bursts into a single call, but guarantees the callback fires within a bounded delay.",
  "keywords": [
    "debounce",
    "throttle",
    "deburst",
    "burst",
    "rate-limit",
    "typescript",
    "esm",
    "cjs"
  ],
  "license": "BlueOak-1.0.0",
  "author": "douira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/douira/deburst-func.git"
  },
  "bugs": {
    "url": "https://github.com/douira/deburst-func/issues"
  },
  "homepage": "https://github.com/douira/deburst-func#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.0",
    "tsdown": "^0.21.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
